# --- Lead delivery (configure at least one, or leads are refused with a clear message) ---
# Email via Resend (https://resend.com). FROM_EMAIL must be on a domain you verified in Resend.
RESEND_API_KEY=
FROM_EMAIL=Cresta Agency <hello@yourdomain.com>
LEADS_TO_EMAIL=you@yourdomain.com
# Optional: POST every lead as JSON to Zapier / Make / Google Apps Script / your CRM
LEADS_WEBHOOK_URL=
# Local server only: folder where leads.jsonl is written (default ./data)
LEADS_DIR=data
PORT=8080
