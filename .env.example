# --- Lead delivery (configure at least one, or leads are refused with a clear message) ---
# Email via Resend (https://resend.com). To email customers, FROM_EMAIL must be on a domain you verified in Resend.
RESEND_API_KEY=
# Sender address. A bare address is fine ("Cresta Agency" is added automatically).
# Leave empty to use Resend's test sender onboarding@resend.dev (delivers only to your Resend account email).
FROM_EMAIL=onboarding@resend.dev
# Where leads are sent (default: crestaagencyco@gmail.com)
LEADS_TO_EMAIL=crestaagencyco@gmail.com
# Optional: POST every lead as JSON to Zapier / Make / Google Apps Script / your CRM
LEADS_WEBHOOK_URL=
# Local server only: folder where leads.jsonl is written (default ./data)
LEADS_DIR=data
PORT=8080
